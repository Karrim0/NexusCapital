# Joya Real Estate - SEO & Performance Optimization
# Apache Configuration

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Force WWW removal (optional - adjust if you want www)
  RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Remove trailing slashes
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [R=301,L]

  # Serve real files under /api/ directly (e.g. uploaded images in api/storage/)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^api/ - [L]

  # Route remaining API requests to the Laravel backend (Backend/public/index.php)
  RewriteCond %{REQUEST_URI} ^/api
  RewriteRule ^api/?(.*)$ Backend/public/index.php [L]

  # SPA Routing - redirect all requests to index.html except existing files/directories
  # This allows React Router to handle client-side routing
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/storage/
  RewriteCond %{REQUEST_URI} !\.(jpg|jpeg|png|gif|ico|svg|css|js|woff|woff2|ttf|eot|json|xml|txt|pdf)$
  RewriteRule ^ index.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  # XSS Protection
  Header set X-XSS-Protection "1; mode=block"
  
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
  
  # Clickjacking protection
  Header set X-Frame-Options "SAMEORIGIN"
  
  # Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Permissions Policy
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # CSS and JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  
  # Fonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  
  # HTML - NO CACHE (always fetch fresh)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/html "A0"
</IfModule>

# Cache-Control Headers
<IfModule mod_headers.c>
  # Images and fonts - long cache (1 year) with immutable
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  
  # CSS and JS files - short cache (1 hour) so deployments show up without manual purging
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=3600, public, must-revalidate"
  </FilesMatch>
  
  # HTML files - NO CACHE (always fetch fresh)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  
  # index.html specifically - always no cache
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# MIME Types
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff .woff
  AddType font/woff2 .woff2
</IfModule>

# Prevent access to sensitive files
<FilesMatch "^(\.htaccess|\.env|\.git|package\.json|composer\.json)$">
    Order allow,deny
    Deny from all
  </FilesMatch>

# Custom Error Pages (Optional)
# ErrorDocument 404 /404.html
# ErrorDocument 500 /500.html