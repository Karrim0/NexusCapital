# =======================
# 🚀 BACKEND ENV CONFIGURATION
# =======================
# هذا ملف مثال لإعدادات Backend
# انسخ المحتوى وأنشئ ملف .env في مجلد nexus-backend

# =======================
# APP CONFIGURATION
# =======================
APP_NAME="Nexus Capital"
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.nexuscapital.com

# =======================
# DATABASE CONFIGURATION
# =======================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# =======================
# SESSION CONFIGURATION (مهم جداً للموبايل!)
# =======================
# استخدم database للـ Session للحصول على أفضل أداء
SESSION_DRIVER=database

# Domain للـ Session (لاحظ النقطة في البداية)
# هذا يسمح للـ Cookies بالعمل على كل Subdomains
# ⚠️ مهم جداً: لازم تبدأ بنقطة (.) عشان الموبايل يشتغل!
SESSION_DOMAIN=.nexuscapital.com

# Session Lifetime (بالدقائق)
SESSION_LIFETIME=120

# Secure Cookie (لازم يكون true مع HTTPS)
# ⚠️ مهم جداً: لازم يكون true عشان SESSION_SAME_SITE=none يشتغل!
SESSION_SECURE_COOKIE=true

# HTTP Only (حماية ضد XSS)
SESSION_HTTP_ONLY=true

# SameSite (مهم جداً للموبايل!)
# ⚠️ مهم جداً: لازم يكون "none" عشان الموبايل يشتغل!
# "none" = يسمح بالـ Cross-site cookies (مطلوب للموبايل)
# "lax" = أكثر أماناً لكن لن يعمل مع الموبايل
# "strict" = أكثر أماناً لكن لن يعمل مع الموبايل
SESSION_SAME_SITE=none

# Partitioned Cookie (عادة false)
SESSION_PARTITIONED_COOKIE=false

# =======================
# CORS CONFIGURATION
# =======================
# URLs المسموح لها بالوصول للـ API
# افصل بين كل URL بفاصلة (,)
FRONTEND_URLS=https://nexuscapital.com,https://www.nexuscapital.com

# =======================
# STORAGE CONFIGURATION
# =======================
# مسار تخزين الصور على السيرفر
UPLOADS_PATH=/home/your_username/public_html/storage

# URL الأساسي للصور (بدون /storage)
FRONTEND_STORAGE_URL=https://nexuscapital.com

# =======================
# MAIL CONFIGURATION
# =======================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=info@nexuscapital.com
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@nexuscapital.com
MAIL_FROM_NAME="${APP_NAME}"

# =======================
# CACHE & QUEUE
# =======================
CACHE_STORE=file
QUEUE_CONNECTION=database

# =======================
# LOGGING
# =======================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# =======================
# BROADCAST, REDIS (Optional)
# =======================
BROADCAST_CONNECTION=log
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =======================
# SANCTUM (API Authentication)
# =======================
SANCTUM_STATEFUL_DOMAINS=nexuscapital.com,www.nexuscapital.com

# =======================
# VITE (Frontend Build)
# =======================
VITE_APP_NAME="${APP_NAME}"

# =======================
# ملاحظات مهمة
# =======================
# 1. استبدل YOUR_APP_KEY_HERE بالمفتاح الخاص بك
#    يمكنك توليد مفتاح جديد بـ: php artisan key:generate
#
# 2. استبدل your_database_* ببيانات قاعدة البيانات الخاصة بك
#
# 3. تأكد من أن SESSION_SAME_SITE=none مع HTTPS فقط
#
# 4. SESSION_DOMAIN يجب أن يبدأ بنقطة (.) للسماح بـ Subdomains
#
# 5. بعد تعديل أي إعداد، نفذ:
#    php artisan config:clear
#    php artisan cache:clear
#
# 6. للموبايل، تأكد من:
#    - SESSION_SAME_SITE=none
#    - SESSION_SECURE_COOKIE=true
#    - HTTPS مفعل
